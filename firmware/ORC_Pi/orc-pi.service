# Tự chạy khi bật Pi:  sudo cp orc-pi.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now orc-pi
# Đường dẫn dưới đây dành cho user "rpi" (repo ở /home/rpi/ORC_RUNNER). User khác thì sửa ExecStart/WorkingDirectory.
# Xem log: journalctl -u orc-pi -f      Dừng để chạy tay/đo thử: sudo systemctl stop orc-pi
[Unit]
Description=ORC robot pose (IMU + optical flow) -> ESP32 qua UART
After=multi-user.target

[Service]
WorkingDirectory=/home/rpi/ORC_RUNNER/firmware/ORC_Pi
ExecStart=/usr/bin/python3 -u /home/rpi/ORC_RUNNER/firmware/ORC_Pi/orc_pi.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
